#!/bin/bash
# Re-encoder terminal launcher (see ./dashboard for the web UI)
# Auto-discovers shows/movies in your libraries, caches the scan, and launches reencode.sh.

# shellcheck source=common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/common.sh"

SCRIPT="${SCRIPT_DIR}/reencode.sh"

echo ""
echo -e "${CYAN}═══════════════════════════════════════════${NC}"
echo -e "${CYAN}              Re-encoder                   ${NC}"
echo -e "${CYAN}═══════════════════════════════════════════${NC}"
echo ""

load_config
mkdir -p "$LOG_DIR"

if [[ ${#LIBRARIES[@]} -eq 0 ]]; then
    echo -e "  ${RED}No media library found.${NC}"
    echo "  Run: ${SCRIPT_DIR}/reencode.sh --setup"
    exit 1
fi
for lib in "${LIBRARIES[@]}"; do
    if [[ ! -d "$lib" ]]; then
        echo -e "  ${RED}Library not found: $lib${NC}"
        echo "  Run: ${SCRIPT_DIR}/reencode.sh --setup"
        exit 1
    fi
done

# Load cache: path<TAB>size<TAB>total<TAB>to_shrink<TAB>done<TAB>scanned_epoch
# First line records the profile settings; changing them invalidates the cache.
CACHE_KEY="#profiles=${TV_HEIGHT}/${TV_KEEP_4K}/${MOVIES_HEIGHT}/${MOVIES_KEEP_4K}/${LIBRARY_PROFILES[*]}/$(cksum 2>/dev/null < "${OVERRIDES_FILE}" | cut -d' ' -f1)"
declare -A CACHE_SIZE CACHE_TOTAL CACHE_1080 CACHE_720 CACHE_TIME
if [[ -f "$CACHE_FILE" && "$(head -1 "$CACHE_FILE")" == "$CACHE_KEY" ]]; then
    while IFS=$'\t' read -r name size total c1080 c720 ctime; do
        [[ -n "$name" && "$name" != \#* ]] || continue
        CACHE_SIZE[$name]="$size"
        CACHE_TOTAL[$name]="$total"
        CACHE_1080[$name]="$c1080"
        CACHE_720[$name]="$c720"
        CACHE_TIME[$name]="$ctime"
    done < "$CACHE_FILE"
fi

needs_rescan() {
    local dir="$1" name="$2" newest
    [[ -z "${CACHE_TIME[$name]:-}" ]] && return 0
    newest=$(find "$dir" -type f "${VIDEO_FIND_EXPR[@]}" -printf '%T@\n' 2>/dev/null | sort -n | tail -1)
    [[ -z "$newest" ]] && return 0
    awk "BEGIN { exit !($newest > ${CACHE_TIME[$name]}) }"
}

# Count files to shrink vs already fine, using the title's profile (same rules as reencode.sh).
scan_show() {
    local dir="$1" name="$2"
    local c1080=0 c720=0 total=0 f
    local -a files=()
    while IFS= read -r -d '' f; do
        files+=("$f")
    done < <(find "$dir" -type f "${VIDEO_FIND_EXPR[@]}" ! -name '.*' -print0 2>/dev/null)
    total=${#files[@]}
    [[ "$total" -eq 0 ]] && return 1
    apply_profile "$dir"
    plan_title "${files[@]}"
    for f in "${files[@]}"; do
        case "${PLAN["$f"]}" in
            encode) c1080=$((c1080 + 1)) ;;
            unknown) ;;
            *) c720=$((c720 + 1)) ;;
        esac
    done

    local size now
    size=$(du -sh "$dir" 2>/dev/null | cut -f1)
    now=$(date +%s)

    CACHE_SIZE[$name]="$size"
    CACHE_TOTAL[$name]="$total"
    CACHE_1080[$name]="$c1080"
    CACHE_720[$name]="$c720"
    CACHE_TIME[$name]="$now"
    return 0
}

declare -a show_dirs=() show_names=() show_sizes=() show_status=() show_total_files=() show_1080_files=() show_720_files=()

while IFS= read -r -d '' dir; do
    show_name=$(basename "$dir")

    if [[ -z "${CACHE_TOTAL[$dir]:-}" ]] || needs_rescan "$dir" "$dir"; then
        scan_show "$dir" "$dir" || continue
    fi
    total="${CACHE_TOTAL[$dir]}"
    size="${CACHE_SIZE[$dir]}"
    count_1080="${CACHE_1080[$dir]}"
    count_720="${CACHE_720[$dir]}"

    if [[ "$count_1080" -eq 0 && "$count_720" -gt 0 ]]; then
        status="${GREEN}DONE${NC}"
    elif [[ "$count_1080" -gt 0 && "$count_720" -gt 0 ]]; then
        status="${YELLOW}PARTIAL${NC}"
    elif [[ "$count_1080" -gt 0 ]]; then
        status="READY"
    else
        status="UNKNOWN"
    fi

    show_dirs+=("$dir")
    show_names+=("$show_name")
    show_sizes+=("$size")
    show_status+=("$status")
    show_total_files+=("$total")
    show_1080_files+=("$count_1080")
    show_720_files+=("$count_720")
done < <(list_titles)

# Save cache
echo "$CACHE_KEY" > "$CACHE_FILE"
for name in "${show_dirs[@]}"; do
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$name" "${CACHE_SIZE[$name]}" "${CACHE_TOTAL[$name]}" \
        "${CACHE_1080[$name]}" "${CACHE_720[$name]}" "${CACHE_TIME[$name]}" \
        >> "$CACHE_FILE"
done

# Display menu
printf "  %-4s %-35s %-8s %-10s %s\n" "#" "SHOW" "SIZE" "FILES" "STATUS"
echo "  ──── ─────────────────────────────────── ──────── ────────── ────────"

for i in "${!show_names[@]}"; do
    num=$((i + 1))
    printf "  %-4s %-35s %-8s " "$num" "${show_names[$i]}" "${show_sizes[$i]}"
    printf "%s/%s    " "${show_720_files[$i]}" "${show_total_files[$i]}"
    echo -e "${show_status[$i]}"
done

echo ""
read -rp "  Pick a show to encode (1-${#show_names[@]}): " choice

if [[ ! "$choice" =~ ^[0-9]+$ || "$choice" -lt 1 || "$choice" -gt "${#show_names[@]}" ]]; then
    echo "Invalid choice."
    exit 1
fi

picked=$((choice - 1))
selected="${show_names[$picked]}"
selected_dir="${show_dirs[$picked]}"
logfile="${LOG_DIR}/$(echo "$selected" | tr ' ' '_' | tr -d '!').log"

# Already done?
if [[ "${show_1080_files[$picked]}" -eq 0 && "${show_720_files[$picked]}" -gt 0 ]]; then
    echo ""
    echo -e "  ${GREEN}Already done!${NC} Nothing left to shrink in this title."
    read -rp "  Re-encode anyway? (y/N): " redo
    if [[ "$redo" != "y" && "$redo" != "Y" ]]; then
        exit 0
    fi
fi

# Already running?
if pgrep -f -- "reencode\.sh.*--dir ${selected_dir}" > /dev/null 2>&1; then
    echo ""
    echo -e "  ${YELLOW}Already running!${NC} Check: tail -f $logfile"
    exit 0
fi

echo ""
echo -e "  Launching encode for: ${CYAN}${selected}${NC}"
echo -e "  ${show_1080_files[$picked]} of ${show_total_files[$picked]} files to encode, ~$(( ${show_1080_files[$picked]} * 4 / 60 )) hours estimated"
echo -e "  Log: $logfile"
echo -e "  Monitor: tail -f $logfile"
echo ""

setsid bash "$SCRIPT" --dir "$selected_dir" > "$logfile" 2>&1 < /dev/null &
echo -e "  ${GREEN}Started!${NC} (PID: $!)"
echo ""
